# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API) and your Typeform webhook configuration.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-only. NEVER prefix with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret you choose when creating the Typeform webhook (Typeform calls it the
# "secret"). Used to verify that webhook requests really come from Typeform.
TYPEFORM_WEBHOOK_SECRET=choose-a-long-random-string
